{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "calorie-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-20",

  "workers_dev": true,

  "routes": [
    {
      "pattern": "calorie-api.anuluca.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": ["ZHIPU_API_KEY"]
  },
  "send_email": [
    {
      "name": "FEEDBACK_EMAIL",
      "destination_address": "tilucario@outlook.com",
      "allowed_sender_addresses": ["feedback@anuluca.com"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calorie-foods",
      "database_id": "4bfe98c1-914a-4018-95ff-282c0c5fa084",
      "migrations_dir": "migrations"
    }
  ]
}
